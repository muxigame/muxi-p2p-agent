<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>muxi-p2p-agent</AssemblyName>
    <RootNamespace>MuxiTunnel.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Not CET (shadow stack) compatible: on Windows 10 before 21H1 with a CET-capable CPU (12th gen Intel
         and later) the .NET 9 runtime asserts at start (!AreShadowStacksEnabled() || UseSpecialUserModeApc()). -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MuxiP2P.Protocol/MuxiP2P.Protocol.csproj" />
    <ProjectReference Include="../MuxiP2P.Client/MuxiP2P.Client.csproj" />
  </ItemGroup>
</Project>
